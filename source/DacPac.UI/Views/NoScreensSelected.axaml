<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:DacPac.UI.ViewModels" x:DataType="viewModel:NoScreensSelectedViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DacPac.UI.Views.NoScreensSelected">
    <ItemsControl HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding Buttons}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewModel:ICommandButton">
                <Button Classes.Accent="{Binding IsAccent}"
                        Command="{Binding RunCommand}"
                        Content="{Binding Text}"
                        IsVisible="{Binding IsVisible}"
                        ToolTip.Tip="{Binding ToolTip}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>